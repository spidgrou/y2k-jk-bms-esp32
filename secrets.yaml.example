# Copy this file to secrets.yaml and fill in your own values.
# secrets.yaml is git-ignored and must never be committed.

wifi_ssid: "YOUR_WIFI_SSID"
wifi_password: "YOUR_WIFI_PASSWORD"

# OTA password — pick your own, it is asked on every over-the-air upload
ota_password: "CHANGE_ME"

# MQTT broker (e.g. the Signal K server or Mosquitto host)
mqtt_broker: "192.168.1.10"

# BLE MAC addresses of the four JK BMS, as reported by the JK app or a BLE scanner
bms1_mac: "AA:BB:CC:DD:EE:01"
bms2_mac: "AA:BB:CC:DD:EE:02"
bms3_mac: "AA:BB:CC:DD:EE:03"
bms4_mac: "AA:BB:CC:DD:EE:04"
